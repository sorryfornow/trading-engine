# Build directories
build/
cmake-build-*/
out/

# Compiled binaries from a direct g++ build, which land in the repo root.
# Anchored with a leading slash: a bare pattern matches at every level, so
# plain `engine` also matched include/engine/ and silently kept the whole
# directory out of the repository.
/bench_bin
/bench_dbg
/engine
/server
/test_bin
/test_main
/test_fix
/test_multibook
/test_spsc
/test_connection
/test_poller

# Object files and debug symbols
*.o
*.a
*.so
*.dylib
*.dSYM/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Profiling output
cachegrind.out.*
callgrind.out.*
perf.data*

# IDE / tooling
.idea/
.vscode/
*.iml
.claude/

# OS
.DS_Store
